---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Produkte"
  description="Alle Versicherungsprodukte von VVB Jürgen Schneider – von Altersvorsorge bis Gewerbeversicherung in Altomünster."
>

  <!-- Page Header -->
  <header class="page-header">
    <div class="container page-header__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/vvbschneider-website/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Produkte</span>
      </nav>
      <h1>Unsere Produkte</h1>
      <p>Umfassende Versicherungslösungen für Privat und Gewerbe – alle aus einer Hand, optimal auf Sie abgestimmt.</p>
    </div>
  </header>

  <!-- Products Grid -->
  <section class="section" aria-labelledby="products-heading">
    <div class="container">

      <!-- Vorsorge -->
      <div style="margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="width: 44px; height: 44px; background: var(--color-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h2 id="products-heading" style="margin-bottom: 0; font-size: 1.6rem;">Vorsorge &amp; Absicherung</h2>
        </div>

        <div class="products-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem;">
          {[
            { name: 'Altersvorsorge', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Pflegevorsorge', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Berufsunfähigkeitsabsicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Absicherung bei schweren Krankheiten', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Riesterförderung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Rürupförderung (Basisrente)', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
          ].map(product => (
            <a href={product.href} class="product-card" style="display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; background: var(--color-surface); border: 1.5px solid var(--color-border); border-radius: var(--radius-lg); text-decoration: none; transition: border-color 0.2s, box-shadow 0.2s;">
              <span style="width: 8px; height: 8px; background: var(--color-secondary); border-radius: 50%; flex-shrink: 0;" aria-hidden="true"></span>
              <span style="color: var(--color-text); font-size: 0.95rem; font-weight: 500;">{product.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Krankenversicherung -->
      <div style="margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="width: 44px; height: 44px; background: var(--color-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <h2 style="margin-bottom: 0; font-size: 1.6rem;">Krankenversicherung</h2>
        </div>

        <div class="products-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem;">
          {[
            { name: 'Gesetzliche Krankenversicherung (GKV)', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Private Krankenversicherung (PKV)', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Zahnzusatzversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Brillen- & Sehhilfen-Zusatzversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Krankentagegeldversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
          ].map(product => (
            <a href={product.href} class="product-card" style="display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; background: var(--color-surface); border: 1.5px solid var(--color-border); border-radius: var(--radius-lg); text-decoration: none; transition: border-color 0.2s, box-shadow 0.2s;">
              <span style="width: 8px; height: 8px; background: var(--color-secondary); border-radius: 50%; flex-shrink: 0;" aria-hidden="true"></span>
              <span style="color: var(--color-text); font-size: 0.95rem; font-weight: 500;">{product.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- KFZ & Mobilität -->
      <div style="margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="width: 44px; height: 44px; background: var(--color-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <h2 style="margin-bottom: 0; font-size: 1.6rem;">KFZ &amp; Mobilität</h2>
        </div>

        <div class="products-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem;">
          {[
            { name: 'KFZ-Haftpflichtversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'KFZ-Teilkaskoversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'KFZ-Vollkaskoversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Motorradversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'E-Bike &amp; Fahrradversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
          ].map(product => (
            <a href={product.href} class="product-card" style="display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; background: var(--color-surface); border: 1.5px solid var(--color-border); border-radius: var(--radius-lg); text-decoration: none; transition: border-color 0.2s, box-shadow 0.2s;">
              <span style="width: 8px; height: 8px; background: var(--color-secondary); border-radius: 50%; flex-shrink: 0;" aria-hidden="true"></span>
              <span style="color: var(--color-text); font-size: 0.95rem; font-weight: 500;">{product.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Wohnen & Hausrat -->
      <div style="margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="width: 44px; height: 44px; background: var(--color-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/></svg>
          </div>
          <h2 style="margin-bottom: 0; font-size: 1.6rem;">Wohnen &amp; Hausrat</h2>
        </div>

        <div class="products-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem;">
          {[
            { name: 'Hausratversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Glasversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Wohngebäudeversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Photovoltaikanlagenversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Elementarschadenversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Gewerbeimmobilienversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
          ].map(product => (
            <a href={product.href} class="product-card" style="display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; background: var(--color-surface); border: 1.5px solid var(--color-border); border-radius: var(--radius-lg); text-decoration: none; transition: border-color 0.2s, box-shadow 0.2s;">
              <span style="width: 8px; height: 8px; background: var(--color-secondary); border-radius: 50%; flex-shrink: 0;" aria-hidden="true"></span>
              <span style="color: var(--color-text); font-size: 0.95rem; font-weight: 500;">{product.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Haftpflicht & Rechtsschutz -->
      <div style="margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="width: 44px; height: 44px; background: var(--color-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <h2 style="margin-bottom: 0; font-size: 1.6rem;">Haftpflicht &amp; Rechtsschutz</h2>
        </div>

        <div class="products-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem;">
          {[
            { name: 'Private Haftpflichtversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Gewerbliche Haftpflichtversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Rechtsschutzversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Tierhalterhaftpflicht', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Hundesteuer &amp; Hundehaftpflicht', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
          ].map(product => (
            <a href={product.href} class="product-card" style="display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; background: var(--color-surface); border: 1.5px solid var(--color-border); border-radius: var(--radius-lg); text-decoration: none; transition: border-color 0.2s, box-shadow 0.2s;">
              <span style="width: 8px; height: 8px; background: var(--color-secondary); border-radius: 50%; flex-shrink: 0;" aria-hidden="true"></span>
              <span style="color: var(--color-text); font-size: 0.95rem; font-weight: 500;">{product.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Unfallversicherung -->
      <div style="margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="width: 44px; height: 44px; background: var(--color-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </div>
          <h2 style="margin-bottom: 0; font-size: 1.6rem;">Unfallversicherung</h2>
        </div>

        <div class="products-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem;">
          {[
            { name: 'Private Unfallversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Unfallversicherung mit Gliedertaxe+', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Berufsunfähigkeits-Unfallversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
          ].map(product => (
            <a href={product.href} class="product-card" style="display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; background: var(--color-surface); border: 1.5px solid var(--color-border); border-radius: var(--radius-lg); text-decoration: none; transition: border-color 0.2s, box-shadow 0.2s;">
              <span style="width: 8px; height: 8px; background: var(--color-secondary); border-radius: 50%; flex-shrink: 0;" aria-hidden="true"></span>
              <span style="color: var(--color-text); font-size: 0.95rem; font-weight: 500;">{product.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Reiseversicherungen -->
      <div style="margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="width: 44px; height: 44px; background: var(--color-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <h2 style="margin-bottom: 0; font-size: 1.6rem;">Reiseversicherungen</h2>
        </div>

        <div class="products-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem;">
          {[
            { name: 'Reiserücktrittsversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Reiseabbruchversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Auslandskrankenversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Reisegepäckversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Reisekrankenversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
          ].map(product => (
            <a href={product.href} class="product-card" style="display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; background: var(--color-surface); border: 1.5px solid var(--color-border); border-radius: var(--radius-lg); text-decoration: none; transition: border-color 0.2s, box-shadow 0.2s;">
              <span style="width: 8px; height: 8px; background: var(--color-secondary); border-radius: 50%; flex-shrink: 0;" aria-hidden="true"></span>
              <span style="color: var(--color-text); font-size: 0.95rem; font-weight: 500;">{product.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Gewerbe & Betrieb -->
      <div>
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="width: 44px; height: 44px; background: var(--color-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          </div>
          <h2 style="margin-bottom: 0; font-size: 1.6rem;">Gewerbe &amp; Betrieb</h2>
        </div>

        <div class="products-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem;">
          {[
            { name: 'Inhaltsversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Transportversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Betriebsunterbrechungsversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Maschinenversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Cyber-Versicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
            { name: 'Betriebshaftpflichtversicherung', href: '/vvbschneider-website/uber-uns-kontakt#kontakt' },
          ].map(product => (
            <a href={product.href} class="product-card" style="display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; background: var(--color-surface); border: 1.5px solid var(--color-border); border-radius: var(--radius-lg); text-decoration: none; transition: border-color 0.2s, box-shadow 0.2s;">
              <span style="width: 8px; height: 8px; background: var(--color-secondary); border-radius: 50%; flex-shrink: 0;" aria-hidden="true"></span>
              <span style="color: var(--color-text); font-size: 0.95rem; font-weight: 500;">{product.name}</span>
            </a>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="section section--alt" aria-label="Beratung anfragen">
    <div class="container">
      <div class="cta-banner reveal">
        <div class="cta-banner__inner">
          <h2>Sie finden nicht, was Sie suchen?</h2>
          <p>Kein Problem – kontaktieren Sie uns und wir finden gemeinsam die passende Lösung.</p>
          <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="/vvbschneider-website/uber-uns-kontakt#kontakt" class="btn btn--primary btn--lg">
              Individuelle Beratung anfragen
            </a>
            <a href="tel:+498****5353" class="btn btn--outline btn--lg">
              08254-995353
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Hover state for product cards */
  .product-card:hover {
    border-color: var(--color-secondary) !important;
    box-shadow: 0 2px 12px rgba(42, 90, 140, 0.12);
  }
</style>