---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Produkte"
  description="Alle Versicherungsprodukte von VVB Jürgen Schneider – von Altersvorsorge bis Gewerbeversicherung in Altomünster."
>

  <!-- Page Header -->
  <header class="page-header">
    <div class="container page-header__inner">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/vvbschneider-website/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Produkte</span>
      </nav>
      <h1>Unsere Produkte</h1>
      <p>Umfassende Versicherungslösungen für Privat und Gewerbe – alle aus einer Hand, optimal auf Sie abgestimmt.</p>
    </div>
  </header>

  <!-- Products Grid -->
  <section class="section" aria-labelledby="products-heading">
    <div class="container">

      <!-- Vorsorge -->
      <div style="margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="width: 44px; height: 44px; background: var(--color-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <h2 id="products-heading" style="margin-bottom: 0; font-size: 1.6rem;">Vorsorge &amp; Absicherung</h2>
        </div>

        <div class="products-list">
          {[
            { icon: '🛡️', name: 'Altersvorsorge' },
            { icon: '🏥', name: 'Pflegevorsorge' },
            { icon: '⚡', name: 'Berufsunfähigkeitsabsicherung' },
            { icon: '🦠', name: 'Schutz bei schweren Krankheiten' },
            { icon: '📈', name: 'Riesterförderung' },
            { icon: '📉', name: 'Rürupförderung (Basisrente)' },
          ].map(product => (
            <div class="product-item" aria-label={product.name}>
              <span class="product-item__icon" aria-hidden="true">{product.icon}</span>
              <span>{product.name}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Kranken & Gesundheit -->
      <div style="margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="width: 44px; height: 44px; background: var(--color-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          </div>
          <h2 style="margin-bottom: 0; font-size: 1.6rem;">Krankenversicherung</h2>
        </div>

        <div class="products-list">
          {[
            { icon: '🏥', name: 'Gesetzliche Krankenversicherung (GKV)' },
            { icon: '🔒', name: 'Private Krankenversicherung (PKV)' },
            { icon: '🦷', name: 'Zahnzusatzversicherung' },
            { icon: '👁️', name: 'Brillen- & Sehhilfen-Zusatzversicherung' },
            { icon: '💊', name: 'Krankentagegeldversicherung' },
          ].map(product => (
            <div class="product-item" aria-label={product.name}>
              <span class="product-item__icon" aria-hidden="true">{product.icon}</span>
              <span>{product.name}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- KFZ & Mobilität -->
      <div style="margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="width: 44px; height: 44px; background: var(--color-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
          <h2 style="margin-bottom: 0; font-size: 1.6rem;">KFZ &amp; Mobilität</h2>
        </div>

        <div class="products-list">
          {[
            { icon: '🚗', name: 'KFZ-Haftpflichtversicherung' },
            { icon: '🛡️', name: 'KFZ-Teilkaskoversicherung' },
            { icon: '🔒', name: 'KFZ-Vollkaskoversicherung' },
            { icon: '🏍️', name: 'Motorradversicherung' },
            { icon: '🚲', name: 'E-Bike & Fahrradversicherung' },
          ].map(product => (
            <div class="product-item" aria-label={product.name}>
              <span class="product-item__icon" aria-hidden="true">{product.icon}</span>
              <span>{product.name}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Wohnen & Hausrat -->
      <div style="margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="width: 44px; height: 44px; background: var(--color-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/></svg>
          </div>
          <h2 style="margin-bottom: 0; font-size: 1.6rem;">Wohnen &amp; Hausrat</h2>
        </div>

        <div class="products-list">
          {[
            { icon: '🏠', name: 'Hausratversicherung' },
            { icon: '🪟', name: 'Glasversicherung' },
            { icon: '🏗️', name: 'Wohngebäudeversicherung' },
            { icon: '☀️', name: 'Photovoltaikanlagenversicherung' },
            { icon: '🌊', name: 'Elementarschadenversicherung' },
            { icon: '🏚️', name: 'Gewerbeimmobilienversicherung' },
          ].map(product => (
            <div class="product-item" aria-label={product.name}>
              <span class="product-item__icon" aria-hidden="true">{product.icon}</span>
              <span>{product.name}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Haftpflicht & Recht -->
      <div style="margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="width: 44px; height: 44px; background: var(--color-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M14.31 8l5.74 9.94M9.69 8h11.48M7.38 12l5.74-9.94M9.69 16L3.95 6.06M14.31 16H2.83M16.62 12l-5.74 9.94"/></svg>
          </div>
          <h2 style="margin-bottom: 0; font-size: 1.6rem;">Haftpflicht &amp; Rechtsschutz</h2>
        </div>

        <div class="products-list">
          {[
            { icon: '👤', name: 'Private Haftpflichtversicherung' },
            { icon: '🏢', name: 'Gewerbliche Haftpflichtversicherung' },
            { icon: '⚖️', name: 'Rechtsschutzversicherung' },
            { icon: '🐾', name: 'Tierhalterhaftpflicht' },
            { icon: '👶', name: 'Hundesteuer & Hundehaftpflicht' },
          ].map(product => (
            <div class="product-item" aria-label={product.name}>
              <span class="product-item__icon" aria-hidden="true">{product.icon}</span>
              <span>{product.name}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Unfall -->
      <div style="margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="width: 44px; height: 44px; background: var(--color-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 10c-.83 0-1.5-.67-1.5-1.5v-5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5z"/><path d="M20.5 10H19V8.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/><path d="M9.5 14c.83 0 1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5S8 21.33 8 20.5v-5c0-.83.67-1.5 1.5-1.5z"/><path d="M3.5 14H5v1.5c0 .83-.67 1.5-1.5 1.5S2 16.33 2 15.5 2.67 14 3.5 14z"/><path d="M14 14.5c0-.83.67-1.5 1.5-1.5h5c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5h-5c-.83 0-1.5-.67-1.5-1.5z"/><path d="M15.5 9H14V7.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/><path d="M10 9.5c0 .83-.67 1.5-1.5 1.5h-5C2.67 11 2 10.33 2 9.5S2.67 8 3.5 8h5c.83 0 1.5.67 1.5 1.5z"/><path d="M8.5 15H10v1.5c0 .83-.67 1.5-1.5 1.5S7 17.33 7 16.5 7.67 15 8.5 15z"/></svg>
          </div>
          <h2 style="margin-bottom: 0; font-size: 1.6rem;">Unfallversicherung</h2>
        </div>

        <div class="products-list">
          {[
            { icon: '🏥', name: 'Private Unfallversicherung' },
            { icon: '⚡', name: 'Unfallversicherung mit Gliedertaxe+' },
            { icon: '👨‍💼', name: 'Berufsunfähigkeits-Unfallversicherung' },
          ].map(product => (
            <div class="product-item" aria-label={product.name}>
              <span class="product-item__icon" aria-hidden="true">{product.icon}</span>
              <span>{product.name}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Reise -->
      <div style="margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="width: 44px; height: 44px; background: var(--color-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          </div>
          <h2 style="margin-bottom: 0; font-size: 1.6rem;">Reiseversicherungen</h2>
        </div>

        <div class="products-list">
          {[
            { icon: '✈️', name: 'Reiserücktrittsversicherung' },
            { icon: '🎒', name: 'Reiseabbruchversicherung' },
            { icon: '🏥', name: 'Auslandskrankenversicherung' },
            { icon: '🧳', name: 'Reisegepäckversicherung' },
            { icon: '🏠', name: 'Reisekrankenversicherung' },
          ].map(product => (
            <div class="product-item" aria-label={product.name}>
              <span class="product-item__icon" aria-hidden="true">{product.icon}</span>
              <span>{product.name}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Gewerbe -->
      <div>
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="width: 44px; height: 44px; background: var(--color-primary); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          </div>
          <h2 style="margin-bottom: 0; font-size: 1.6rem;">Gewerbe &amp; Betrieb</h2>
        </div>

        <div class="products-list">
          {[
            { icon: '📦', name: 'Inhaltsversicherung' },
            { icon: '🚚', name: 'Transportversicherung' },
            { icon: '⏱️', name: 'Betriebsunterbrechungsversicherung' },
            { icon: '⚙️', name: 'Maschinenversicherung' },
            { icon: '💻', name: 'Cyber-Versicherung' },
            { icon: '📋', name: 'Betriebshaftpflichtversicherung' },
          ].map(product => (
            <div class="product-item" aria-label={product.name}>
              <span class="product-item__icon" aria-hidden="true">{product.icon}</span>
              <span>{product.name}</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="section section--alt" aria-label="Beratung anfragen">
    <div class="container">
      <div class="cta-banner reveal">
        <div class="cta-banner__inner">
          <h2>Sie finden nicht, was Sie suchen?</h2>
          <p>Kein Problem – kontaktieren Sie uns und wir finden gemeinsam die passende Lösung.</p>
          <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
            <a href="/vvbschneider-website/uber-uns-kontakt#kontakt" class="btn btn--primary btn--lg">
              Individuelle Beratung anfragen
            </a>
            <a href="tel:+498254995353" class="btn btn--outline btn--lg">
              08254-995353
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
